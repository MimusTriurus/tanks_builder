# Blender's rolling backups. The .blend beside them is the file of record, and
# each backup is another 57MB of the same thing.
*.blend1
*.blend2

# Python
__pycache__/
*.py[cod]

# Godot / .NET build output. .godot/ is a rebuildable import cache and the mono
# build drops compiled assemblies inside it.
GodotTest/.godot/
GodotTest/bin/
GodotTest/obj/
GodotTest/*.sln

# Harness screenshots (F12) and one-off verification captures
GodotTest/shot_*.png
GodotTest/_verify.png

# Scratch output from ad-hoc script runs; Sprites/ is the real output and is
# tracked.
out/

# Sound set for the bench, staged by stage_sounds.sh from a Blitzkrieg 2
# checkout. Not tracked, and it must not be: Nival's licence for that release is
# non-commercial and revocable, so the bytes stay off this repository and the
# script is the record of where they came from. Re-run it to rebuild the folder.
Sounds/

# Rider's project files. Per-machine and rewritten constantly - workspace.xml
# alone changes on every window move - and they say nothing about the bench.
GodotTest/.idea/

# Skill documents for the bench's own MCP tools, written by the addon's
# godot-skill-generate step from the [AiTool] attributes in the C# beside them.
# Generated, not authored: the tool declarations are the record, and these fifty
# files are a rendering of them that regenerates on demand and would otherwise
# turn up in a diff every time a description is reworded.
GodotTest/.claude/skills/

# A hand-made backup of the csproj from the day the build was pointed at an
# installed engine. Git is the backup.
GodotTest/TankSpriteTest.csproj.old

# Claude Code's per-machine settings. Its sibling .claude/settings.json IS
# tracked - that one declares the project's MCP server and belongs to the repo,
# the same way .mcp.json does. This one accumulates whatever a session happened
# to allow, including absolute scratchpad paths, so it is nobody else's.
.claude/settings.local.json
