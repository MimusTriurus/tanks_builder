<?xml version="1.0" encoding="utf-8"?>
<!--
  Godot.NET.Sdk has to match the engine exactly (4.5.2 here), and that build
  ships inside the engine install. Pointing at it directly means `dotnet build`
  works offline and can never resolve a different patch version than the editor
  is running.
-->
<configuration>
  <packageSources>
    <add key="godot-bundled"
         value="D:\Soft\Godot_v4.5.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
